generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("CUSTOMER") // CUSTOMER | VENDOR | ADMIN
  phone        String?
  city         String?
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendorProfile VendorProfile?
  events        Event[]
  savedVendors  SavedVendor[]
  bookings      Booking[]
  reviews       Review[]
  sessions      Session[]

  @@index([email])
  @@index([role])
}

model Category {
  id          String          @id @default(uuid())
  name        String          @unique // Photography, Catering, Decoration, Venue, Makeup, DJ, Videography, Event Planning, Mehendi, Florist
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vendors     VendorProfile[]
}

model VendorProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  businessName     String
  categoryId       String
  description      String?
  shortDescription String?
  location         String
  experienceYears  Int            @default(0)
  startingPrice    Int            @default(0)
  rating           Float          @default(0)
  reviewCount      Int            @default(0)
  verified         Boolean        @default(false)
  availability     Boolean        @default(true)
  featured         Boolean        @default(false)
  featuredImage    String?
  images           String[]
  styles           String[]
  languages        String[]
  serviceAreas     String[]
  eventTypes       String[]
  contactPhone     String?
  contactEmail     String?
  contactInstagram String?
  contactAddress   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category       @relation(fields: [categoryId], references: [id])
  services         VendorService[]
  packages         VendorPackage[]
  portfolioItems   PortfolioItem[]
  availabilities   Availability[]
  bookings         Booking[]
  savedBy          SavedVendor[]
  reviews          Review[]
  recommendations  Recommendation[]

  @@index([categoryId])
  @@index([location])
  @@index([startingPrice])
  @@index([rating])
  @@index([verified])
}

model VendorService {
  id          String        @id @default(uuid())
  vendorId    String
  name        String
  description String?
  price       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorPackage {
  id          String        @id @default(uuid())
  vendorId    String
  name        String
  description String?
  price       Int
  features    String[]
  popular     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([vendorId])
}

model PortfolioItem {
  id          String        @id @default(uuid())
  vendorId    String
  imageUrl    String
  title       String
  description String?
  createdAt   DateTime      @default(now())

  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Availability {
  id        String        @id @default(uuid())
  vendorId  String
  date      DateTime
  available Boolean       @default(true)
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([vendorId])
  @@index([date])
}

model Event {
  id                String           @id @default(uuid())
  userId            String
  name              String
  type              String           // Wedding, Birthday, Engagement, Corporate, Anniversary, Party, etc.
  date              DateTime
  location          String
  guestCount        Int
  budget            Int              // Total budget in INR
  style             String[]         // e.g. ["Traditional", "Modern"]
  requirements      String[]         // e.g. ["Photography", "Catering"]
  budgetAllocations Json?            // e.g. { "venue": 75000, "photography": 45000 }
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  recommendations   Recommendation[]

  @@index([userId])
  @@index([date])
}

model SavedVendor {
  id        String        @id @default(uuid())
  userId    String
  vendorId  String
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

model Booking {
  id          String         @id @default(uuid())
  userId      String
  vendorId    String
  eventId     String?
  packageId   String?
  packageName String
  bookingDate DateTime
  amount      Int
  status      String         @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED | REJECTED
  eventName   String
  guestCount  Int?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor      VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  event       Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  package     VendorPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  reviews     Review[]

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([bookingDate])
}

model Review {
  id        String        @id @default(uuid())
  userId    String
  vendorId  String
  bookingId String?
  rating    Float
  comment   String
  userName  String?
  eventType String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  booking   Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([userId])
}

model Recommendation {
  id                String        @id @default(uuid())
  eventId           String
  vendorId          String
  score             Float         // 0 - 100
  budgetScore       Float
  locationScore     Float
  ratingScore       Float
  availabilityScore Float
  styleScore        Float
  experienceScore   Float
  reason            String
  createdAt         DateTime      @default(now())

  event             Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor            VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
  @@index([eventId])
  @@index([vendorId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}